<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>WarpCode.Outcomes</Title>
    <Description>
      A small, monadic Result-type library, targeting .NET 10 and above.
      Outcomes are a fluent, compositional discriminated union type representing a value or a problem.
      Outcomes support R.O.P. flow control (Railway Orientated Programming) via composition
      with full async support.
    </Description>
    <PackageProjectUrl>https://github.com/pwarner/WarpCode.Outcomes</PackageProjectUrl>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>WarpCode;Outcomes;Outcome;WarpCode.Outcomes;Result;Results;Result Union;Outcome Union;Either;ErrorOr;OneOf;ROP;Railway Orientated Programming</PackageTags>
    <RepositoryUrl>https://github.com/pwarner/WarpCode.Outcomes</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RootNamespace>WarpCode.Outcomes</RootNamespace>
    <PackageId>WarpCode.Outcomes</PackageId>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- publish a .snupkg to the NuGet symbol server alongside the package -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- The package version is set by the release workflow from the GitHub Release tag (-p:Version=...). -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
